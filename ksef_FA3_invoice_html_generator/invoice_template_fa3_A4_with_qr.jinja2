        <p class="info-item">
            {% if zam.data_zamowienia %}Data: {{ zam.data_zamowienia }}{% endif %}
            {% if zam.nr_zamowienia %}{% if zam.data_zamowienia %}, {% endif %}Nr: {{ zam.nr_zamowienia }}{% endif %}
        </p>
        {% endfor %}
        {% endif %}
        
        <!-- Numery partii towaru -->
        {% if warunki_transakcji.numery_partii_towaru and warunki_transakcji.numery_partii_towaru|length > 0 %}
        <p class="info-item"><span class="label">Numery partii towaru:</span> {{ warunki_transakcji.numery_partii_towaru|join(', ') }}</p>
        {% endif %}
        
        <!-- Warunki dostawy -->
        {% if warunki_transakcji.warunki_dostawy %}
        <p class="info-item"><span class="label">Warunki dostawy:</span> {{ warunki_transakcji.warunki_dostawy }}</p>
        {% endif %}
        
        <!-- Kurs i waluta umowna -->
        {% if warunki_transakcji.kurs_umowny or warunki_transakcji.waluta_umowna %}
        <p class="info-item">
            <span class="label">Kurs umowny:</span> 
            {% if warunki_transakcji.kurs_umowny %}{{ warunki_transakcji.kurs_umowny }}{% endif %}
            {% if warunki_transakcji.waluta_umowna %} {{ warunki_transakcji.waluta_umowna }}{% endif %}
        </p>
        {% endif %}
        
        <!-- Transport -->
        {% if warunki_transakcji.transport and warunki_transakcji.transport|length > 0 %}
        <p><strong>Transport:</strong></p>
        {% for transport in warunki_transakcji.transport %}
        <div style="margin-left: 20px; margin-bottom: 10px;">
            {% if transport.rodzaj_transportu %}
            <p class="info-item"><span class="label">Rodzaj:</span> {{ transport.rodzaj_transportu }}</p>
            {% endif %}
            {% if transport.transport_inny == '1' and transport.opis_innego_transportu %}
            <p class="info-item"><span class="label">Transport inny:</span> {{ transport.opis_innego_transportu }}</p>
            {% endif %}
            {% if transport.nr_zlecenia_transportu %}
            <p class="info-item"><span class="label">Nr zlecenia:</span> {{ transport.nr_zlecenia_transportu }}</p>
            {% endif %}
            {% if transport.opis_ladunku %}
            <p class="info-item"><span class="label">Ładunek:</span> {{ transport.opis_ladunku }}</p>
            {% endif %}
            {% if transport.ladunek_inny == '1' and transport.opis_innego_ladunku %}
            <p class="info-item"><span class="label">Ładunek inny:</span> {{ transport.opis_innego_ladunku }}</p>
            {% endif %}
            {% if transport.jednostka_opakowania %}
            <p class="info-item"><span class="label">Jednostka opakowania:</span> {{ transport.jednostka_opakowania }}</p>
            {% endif %}
            {% if transport.data_godz_rozp_transportu %}
            <p class="info-item"><span class="label">Początek:</span> {{ transport.data_godz_rozp_transportu }}</p>
            {% endif %}
            {% if transport.data_godz_zak_transportu %}
            <p class="info-item"><span class="label">Koniec:</span> {{ transport.data_godz_zak_transportu }}</p>
            {% endif %}
            {% if transport.wysylka_z %}
            <p class="info-item"><span class="label">Wysyłka z:</span> {{ transport.wysylka_z.adres_l1 }}{% if transport.wysylka_z.adres_l2 %}, {{ transport.wysylka_z.adres_l2 }}{% endif %}</p>
            {% endif %}
            {% if transport.wysylka_do %}
            <p class="info-item"><span class="label">Wysyłka do:</span> {{ transport.wysylka_do.adres_l1 }}{% if transport.wysylka_do.adres_l2 %}, {{ transport.wysylka_do.adres_l2 }}{% endif %}</p>
            {% endif %}
            {% if transport.przewoznik %}
            <p class="info-item"><span class="label">Przewoźnik:</span> {{ transport.przewoznik.dane_identyfikacyjne.nazwa }}{% if transport.przewoznik.dane_identyfikacyjne.nip %} (NIP: {{ transport.przewoznik.dane_identyfikacyjne.nip }}){% endif %}</p>
            {% endif %}
        </div>
        {% endfor %}
        {% endif %}
        
        <!-- Podmiot pośredniczący -->
        {% if warunki_transakcji.podmiot_posredniczacy == '1' %}
        <p class="info-item"><span class="label">Podmiot pośredniczący:</span> Tak</p>
        {% endif %}
    </div>
    {% endif %}
        
        <!-- Faktury korygowane -->
        {% if faktury_korygowane and faktury_korygowane|length > 0 %}
        <div class="corrected-invoices">
            <h3>📋 Faktury korygowane</h3>
            {% for faktura in faktury_korygowane %}
            <div style="margin-bottom: 15px; padding: 10px; border: 1px solid #ddd; background-color: white;">
                <p><strong>Numer:</strong> {{ faktura.numer }}</p>
                {% if faktura.data_wystawienia %}
                <p><strong>Data wystawienia:</strong> {{ faktura.data_wystawienia }}</p>
                {% endif %}
                {% if faktura.nr_ksef %}
                <p><strong>Nr KSeF:</strong> {{ faktura.nr_ksef }}</p>
                {% endif %}
                {% if faktura.przyczyna_korekty %}
                <div class="correction-reason">
                    <strong>Przyczyna korekty:</strong> {{ faktura.przyczyna_korekty }}
                </div>
                {% endif %}
                {% if faktura.okr_od and faktura.okr_do %}
                <p><strong>Okres:</strong> {{ faktura.okr_od }} - {{ faktura.okr_do }}</p>
                {% endif %}
            </div>
            {% endfor %}
        </div>
        {% endif %}
        
        <!-- Faktury zaliczkowe -->
    {% if faktury_zaliczkowe and faktury_zaliczkowe|length > 0 %}
    <div class="advance-invoices">
        <h3>💰 Faktury zaliczkowe</h3>
        <table>
            <tr>
                <th>Nr faktury zaliczkowej</th>
                <th>Nr KSeF</th>
                <th>Nr KSeF ZN</th>
            </tr>
            {% for faktura in faktury_zaliczkowe %}
            <tr>
                <td>{{ faktura.nr_fa_zaliczkowej }}</td>
                <td>{{ faktura.nr_ksef_fa_zaliczkowej }}</td>
                <td>{{ faktura.nr_ksef_zn }}</td>
            </tr>
            {% endfor %}
        </table>
    </div>
    {% endif %}
        
        <!-- Zaliczki częściowe (dla faktur korygujących) -->
        {% if zaliczki_czesciowe and zaliczki_czesciowe|length > 0 %}
        <div class="partial-advances">
            <h3>Zaliczki częściowe</h3>
            <table>
                <tr>
                    <th>Data płatności</th>
                    <th class="number">Kwota płatności</th>
                    <th class="number">Kurs waluty</th>
                </tr>
                {% for zaliczka in zaliczki_czesciowe %}
                <tr>
                    <td>{{ zaliczka.data_platnosci }}</td>
                    <td class="number">{{ zaliczka.kwota_platnosci }}</td>
                    <td class="number">{{ zaliczka.kurs_waluty }}</td>
                </tr>
                {% endfor %}
            </table>
        </div>
        {% endif %}
        
        <!-- Szczegółowe rozliczenie (obciążenia i odliczenia) -->
        {% if rozliczenie and (rozliczenie.obciazenia or rozliczenie.odliczenia) %}
        <div class="additional-info">
            <h3>Szczegółowe rozliczenie</h3>
            {% if rozliczenie.obciazenia and rozliczenie.obciazenia|length > 0 %}
            <p class="label">Obciążenia:</p>
            {% for obciazenie in rozliczenie.obciazenia %}
            <p class="info-item" style="margin-left: 20px;">
                {{ obciazenie.powod }}: <strong>{{ obciazenie.kwota }} {{ waluta }}</strong>
            </p>
            {% endfor %}
            {% endif %}
            {% if rozliczenie.odliczenia and rozliczenie.odliczenia|length > 0 %}
            <p class="label" style="margin-top: 10px;">Odliczenia:</p>
            {% for odliczenie in rozliczenie.odliczenia %}
            <p class="info-item" style="margin-left: 20px;">
                {{ odliczenie.powod }}: <strong>{{ odliczenie.kwota }} {{ waluta }}</strong>
            </p>
            {% endfor %}
            {% endif %}
        </div>
        {% endif %}
        
        <!-- Załącznik -->
        {% if zalacznik and zalacznik.bloki_danych %}
        <div class="attachment">
            <h3>📎 Załącznik do faktury VAT</h3>
            
            {% for blok in zalacznik.bloki_danych %}
            <div class="attachment-block">
                <h4>Szczegółowe dane załącznika ({{ loop.index }})</h4>
                
                {# Nagłówek bloku danych #}
                {% if blok.naglowek %}
                <p><strong>Nagłówek bloku danych:</strong> {{ blok.naglowek }}</p>
                {% endif %}
                
                {# MetaDane - tabela klucz/wartość #}
                {% if blok.meta_dane %}
                <table class="attachment-meta-table">
                    <thead>
                        <tr>
                            <th style="width: 40%;">Klucz</th>
                            <th style="width: 60%;">Wartość</th>
                        </tr>
                    </thead>
                    <tbody>
                        {% for meta in blok.meta_dane %}
                        <tr>
                            <td>{{ meta.klucz }}</td>
                            <td>{{ meta.wartosc }}</td>
                        </tr>
                        {% endfor %}
                    </tbody>
                </table>
                {% endif %}
                
                {# Tekst z akapitami #}
                {% if blok.tekst and blok.tekst.akapity %}
                <div class="attachment-text">
                    {% for akapit in blok.tekst.akapity %}
                    <p>Opis ({{ loop.index }}): {{ akapit }}</p>
                    {% endfor %}
                </div>
                {% endif %}
                
                {# Tabele #}
                {% if blok.tabele %}
                {% for tabela in blok.tabele %}
                <div style="margin-top: 15px;">
                    {# Opis tabeli #}
                    {% if tabela.opis %}
                    <div class="attachment-table-title">{{ tabela.opis }}</div>
                    {% endif %}
                    
                    {# Metadane tabeli #}
                    {% if tabela.meta_dane %}
                    <table class="attachment-meta-table" style="margin-bottom: 5px;">
                        <thead>
                            <tr>
                                <th style="width: 40%;">Klucz</th>
                                <th style="width: 60%;">Wartość</th>
                            </tr>
                        </thead>
                        <tbody>
                            {% for tmeta in tabela.meta_dane %}
                            <tr>
                                <td>{{ tmeta.klucz }}</td>
                                <td>{{ tmeta.wartosc }}</td>
                            </tr>
                            {% endfor %}
                        </tbody>
                    </table>
                    {% endif %}
                    
                    {# Nagłówek i dane tabeli #}
                    {% if tabela.naglowek or tabela.wiersze %}
                    <table class="attachment-data-table">
                        {% if tabela.naglowek %}
                        <thead>
                            <tr>
                                {% for kol in tabela.naglowek %}
                                <th>{{ kol.nazwa }}</th>
                                {% endfor %}
                            </tr>
                        </thead>
                        {% endif %}
                        <tbody>
                            {% if tabela.wiersze %}
                            {% for wiersz in tabela.wiersze %}
                            <tr>
                                {% for komorka in wiersz %}
                                <td>{{ komorka if komorka else '' }}</td>
                                {% endfor %}
                            </tr>
                            {% endfor %}
                            {% endif %}
                            
                            {# Wiersz sumy #}
                            {% if tabela.suma %}
                            <tr class="sum-row">
                                {% for komorka in tabela.suma %}
                                <td>{{ komorka if komorka else '' }}</td>
                                {% endfor %}
                            </tr>
                            {% endif %}
                        </tbody>
                    </table>
                    {% endif %}
                </div>
                {% endfor %}
                {% endif %}
            </div>
            {% endfor %}
        </div>
        {% endif %}
        
        <!-- Stopka -->
        <div class="footer-section">
            {% if stopka and stopka.informacje and stopka.informacje.stopka_faktury %}
            <p>{{ stopka.informacje.stopka_faktury }}</p>
            {% endif %}
        {% if stopka and stopka.informacje and stopka.informacje.warunki_dodatkowe and stopka.informacje.warunki_dodatkowe|length > 0 %}
        <p style="margin-top: 10px;"><strong>Warunki dodatkowe:</strong></p>
        <ul style="margin: 5px 0; padding-left: 20px;">
        {% for warunek in stopka.informacje.warunki_dodatkowe %}
            <li>{{ warunek }}</li>
        {% endfor %}
        </ul>
        {% endif %}
            {% if stopka and stopka.rejestry %}
            <p>
            {% if stopka.rejestry.krs %}KRS: {{ stopka.rejestry.krs }} | {% endif %}
            {% if stopka.rejestry.regon %}REGON: {{ stopka.rejestry.regon }} | {% endif %}
            {% if stopka.rejestry.bdo %}BDO: {{ stopka.rejestry.bdo }} | {% endif %}
            {% if stopka.rejestry.ceidg %}CEIDG: {{ stopka.rejestry.ceidg }}{% endif %}
            </p>
            {% endif %}
            <p style="font-size: 9pt; color: #999; margin-top: 10px;">
                Faktura wygenerowana: {{ naglowek.system_info }} | FA(3) {{ naglowek.wersja_schemy }}
            </p>
        </div>
        
        {% if ksef_qr_data_uri %}
        <div class="ksef-qr-section">
            <p class="ksef-qr-title">Kod QR — weryfikacja w KSeF (online)</p>
            <img class="ksef-qr-image" src="{{ ksef_qr_data_uri }}" alt="Kod QR weryfikacji faktury KSeF" />
            {% if ksefNumber %}
            <p class="ksef-qr-caption">KSeF: {{ ksefNumber }}</p>
            {% endif %}
        </div>
        {% endif %}
    </div>
</body>
</html>
