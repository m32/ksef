<!DOCTYPE html>
<html lang="pl">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Faktura {{ numer }}</title>
    <style>
        /* Tło strony */
        body {
            font-family: Arial, sans-serif;
            background-color: #e0e0e0;
            margin: 0;
            padding: 20px 0;
            font-size: 10pt;
            color: #333;
        }
        
        /* Kontener A4 - zawsze stała szerokość */
        .page-container {
            width: 210mm;
            min-height: 297mm;
            margin: 0 auto;
            background-color: white;
            padding: 20mm;
            box-shadow: 0 0 10px rgba(0, 0, 0, 0.3);
            box-sizing: border-box;
        }
        
        .header {
            display: flex;
            justify-content: space-between;
            align-items: flex-start;
            margin-bottom: 30px;
            border-bottom: 2px solid #333;
            padding-bottom: 20px;
        }
        
        .header-left h1 {
            margin: 0;
            font-size: 24pt;
        }
        
        .header-left .invoice-type {
            font-size: 12pt;
            color: #666;
            margin-top: 5px;
        }
        
        .header-right {
            text-align: right;
        }
        
        .header-right .invoice-number {
            font-size: 16pt;
            margin-bottom: 10px;
            font-weight: bold;
        }
        
        .header-right .dates {
            font-size: 10pt;
            color: #666;
        }
        
        .header-right .dates p {
            margin: 3px 0;
        }
        
        .header-right .ksef-number {
            font-size: 7pt;
            color: #999;
            margin-top: 5px;
            font-style: italic;
        }
        
        .parties {
            display: flex;
            justify-content: space-between;
            margin-bottom: 30px;
            gap: 20px;
        }
        
        .party {
            width: 48%;
            border: 1px solid #ccc;
            padding: 15px;
            background-color: #f9f9f9;
        }
        
        .party h2 {
            margin-top: 0;
            font-size: 14pt;
            border-bottom: 1px solid #ccc;
            padding-bottom: 5px;
        }
        
        .party p {
            margin: 5px 0;
        }
        
        .contact-info {
            margin-top: 10px;
            font-size: 10pt;
            color: #666;
        }
        
        .third-party {
            margin-bottom: 20px;
            padding: 15px;
            border: 1px solid #ccc;
            background-color: #f5f5f5;
        }
        
        .third-party h3 {
            margin-top: 0;
            font-size: 11pt;
            border-bottom: 1px solid #999;
            padding-bottom: 5px;
        }
        
        table {
            width: 100%;
            border-collapse: collapse;
            margin-bottom: 20px;
        }
        
        th, td {
            border: 1px solid #ccc;
            padding: 4px;
            text-align: left;
            font-size: 8pt;
        }
        
        th {
            background-color: #e8e8e8;
            font-weight: bold;
            font-size: 8pt;
        }
        
        /* Szerokości kolumn w tabeli pozycji (Lp/Ilość/J.m. −25%; kwoty +oszczędność głównie 5 i 8) */
        .items-table th:nth-child(1), .items-table td:nth-child(1) { width: 17px; }
        .items-table th:nth-child(2) { width: auto; }
        .items-table td:nth-child(2) { width: auto; }
        .items-table th:nth-child(3), .items-table td:nth-child(3) { width: 26px; }
        .items-table th:nth-child(4), .items-table td:nth-child(4) { width: 21px; }
        .items-table th:nth-child(5), .items-table td:nth-child(5) { width: 52px; }
        .items-table th:nth-child(6), .items-table td:nth-child(6) { width: 57px; }
        .items-table th:nth-child(7), .items-table td:nth-child(7) { width: 23px; }
        .items-table th:nth-child(8), .items-table td:nth-child(8) { width: 52px; }
        .items-table th:nth-child(9), .items-table td:nth-child(9) { width: 57px; }
        
        /* Szerokości kolumn w tabeli zamówienia */
        .order-table th:nth-child(1), .order-table td:nth-child(1) { width: 17px; }  /* Lp */
        .order-table th:nth-child(2), .order-table td:nth-child(2) { width: auto; }  /* Nazwa */
        .order-table th:nth-child(3), .order-table td:nth-child(3) { width: 26px; }  /* Ilość */
        .order-table th:nth-child(4), .order-table td:nth-child(4) { width: 21px; }  /* J.m. */
        .order-table th:nth-child(5), .order-table td:nth-child(5) { width: 52px; }  /* Cena netto */
        .order-table th:nth-child(6), .order-table td:nth-child(6) { width: 57px; }  /* Wartość netto */
        .order-table th:nth-child(7), .order-table td:nth-child(7) { width: 23px; }  /* VAT % */
        .order-table th:nth-child(8), .order-table td:nth-child(8) { width: 52px; }  /* Kwota VAT */
        .order-table th:nth-child(9), .order-table td:nth-child(9) { width: 57px; }  /* Wartość brutto */
        
        /* nowrap tylko w komórkach wartości — nagłówki mogą się łamać */
        .items-table td.number,
        .order-table td.number {
            white-space: nowrap;
        }
        
        .number {
            text-align: right;
        }
        
        .center {
            text-align: center;
        }
        
        .annotations {
            margin-bottom: 20px;
            padding: 15px;
            border: 1px solid #ccc;
            background-color: #f9f9f9;
        }
        
        .annotations h3 {
            margin-top: 0;
            font-size: 11pt;
            border-bottom: 1px solid #333;
            padding-bottom: 5px;
        }
        
        .annotations table {
            margin-top: 10px;
        }
        
        .annotations td {
            text-align: center;
            font-size: 8pt;
        }
        
        .split-payment-yes {
            background-color: #ddd;
            font-weight: bold;
        }
        
        .vat-breakdown {
            margin-bottom: 20px;
            text-align: right;
        }
        
        .vat-breakdown h3 {
            margin: 0 0 10px 0;
            font-size: 11pt;
            text-align: left;
            width: 400px;
            margin-left: auto;
        }
        
        .vat-breakdown table {
            width: 400px;
            margin-left: auto;
        }
        
        .vat-breakdown .total-row {
            font-size: 7pt;
        }
        
        .summary {
            margin-top: 20px;
            text-align: right;
        }
        
        .summary table {
            width: 400px;
            margin-left: auto;
        }
        
        .summary th {
            text-align: left;
            background-color: #f5f5f5;
        }
        
        .total {
            font-weight: bold;
            font-size: 11pt;
            background-color: #e0e0e0;
        }
        
        .payment-info, .additional-info, .corrected-invoices, .advance-invoices, .partial-advances, .attachment {
            margin-top: 30px;
            padding: 15px;
            border: 1px solid #ccc;
            background-color: #f9f9f9;
        }
        
        .payment-info h3, .additional-info h3, .corrected-invoices h3, .advance-invoices h3, .partial-advances h3, .attachment h3 {
            margin-top: 0;
            border-bottom: 1px solid #333;
            padding-bottom: 5px;
        }
        
        .attachment-block {
            margin-top: 15px;
            padding: 10px;
            border: 1px solid #ddd;
            background-color: #fff;
        }
        .attachment-block h4 {
            margin: 0 0 10px 0;
            font-size: 10pt;
            color: #333;
        }
        .attachment-meta-table {
            width: 100%;
            border-collapse: collapse;
            margin-bottom: 15px;
            font-size: 9pt;
        }
        .attachment-meta-table th {
            background-color: #e0e0e0;
            padding: 6px 8px;
            text-align: left;
            border: 1px solid #ccc;
            font-weight: bold;
        }
        .attachment-meta-table td {
            padding: 6px 8px;
            border: 1px solid #ccc;
        }
        .attachment-data-table {
            width: 100%;
            border-collapse: collapse;
            margin-bottom: 15px;
            font-size: 8pt;
        }
        .attachment-data-table th {
            background-color: #d0d0d0;
            padding: 5px 6px;
            text-align: left;
            border: 1px solid #999;
            font-weight: bold;
        }
        .attachment-data-table td {
            padding: 4px 6px;
            border: 1px solid #ccc;
        }
        .attachment-data-table tr.sum-row {
            background-color: #f0f0f0;
            font-weight: bold;
        }
        .attachment-table-title {
            font-weight: bold;
            margin: 10px 0 5px 0;
            font-size: 9pt;
        }
        .attachment-text {
            margin: 10px 0;
            font-size: 9pt;
            font-style: italic;
        }
        
        .footer-section {
            margin-top: 30px;
            padding-top: 15px;
            border-top: 2px solid #333;
            font-size: 10pt;
            color: #666;
        }
        
        .info-item {
            margin: 5px 0;
        }
        
        .label {
            font-weight: bold;
        }
        
        .correction-reason {
            margin: 10px 0;
            padding: 10px;
            background-color: #e8e8e8;
            border-left: 4px solid #666;
            font-weight: bold;
        }
        
        .ksef-qr-section {
            margin-top: 24px;
            padding-top: 20px;
            border-top: 1px solid #ccc;
            text-align: center;
            font-size: 9pt;
            color: #333;
        }
        .ksef-qr-section .ksef-qr-title {
            font-weight: bold;
            margin-bottom: 8px;
            font-size: 10pt;
        }
        .ksef-qr-section .ksef-qr-image {
            display: block;
            margin: 8px auto;
            max-width: 200px;
            height: auto;
        }
        .ksef-qr-section .ksef-qr-caption {
            margin-top: 6px;
            color: #555;
            font-size: 8pt;
            word-break: break-all;
        }
        
        /* Style drukowania */
        @media print {
            body {
                background-color: white;
                padding: 0;
            }
            .page-container {
                width: 100%;
                margin: 0;
                box-shadow: none;
                padding: 0;
            }
        }
    </style>
</head>
<body>
    <div class="page-container">
        <!-- Nagłówek -->
        <div class="header">
            <div class="header-left">
                <h1>FAKTURA</h1>
                <div class="invoice-type">{% if rodzaj_faktury %}{{ rodzaj_faktury }}{% else %}VAT{% endif %}{% if typ_cen %} ({{ typ_cen }}){% endif %}</div>
            </div>
            <div class="header-right">
                <div class="invoice-number">Nr {{ numer }}</div>
                <div class="dates">
                    <p><strong>Data wystawienia:</strong> {{ data_wystawienia }}</p>
                    {% if data_sprzedazy %}
                    <p><strong>Data sprzedaży:</strong> {{ data_sprzedazy }}</p>
                    {% elif okres_sprzedazy %}
                    <p><strong>Okres sprzedaży:</strong> {{ okres_sprzedazy.od }} - {{ okres_sprzedazy.do }}</p>
                    {% endif %}
                    {% if miejsce_wystawienia %}
                    <p><strong>Miejsce wystawienia:</strong> {{ miejsce_wystawienia }}</p>
                    {% endif %}
                    <p><strong>Waluta:</strong> {{ waluta }}</p>
                {% if numery_wz and numery_wz|length > 0 %}
                <p><strong>Numery WZ:</strong> {{ numery_wz|join(', ') }}</p>
                {% endif %}
            </div>
                {% if ksefNumber %}
                <div class="ksef-number">KSeF: {{ ksefNumber }}</div>
                {% endif %}
            </div>
        </div>
        
        <!-- Podmioty -->
        <div class="parties">
            <div class="party">
                <h2>Sprzedawca</h2>
                <p class="label">{{ sprzedawca.dane_identyfikacyjne.nazwa }}</p>
                {% if sprzedawca.dane_identyfikacyjne.pelna_nazwa %}
                <p>{{ sprzedawca.dane_identyfikacyjne.pelna_nazwa }}</p>
                {% endif %}
                <p><strong>NIP:</strong> {{ sprzedawca.dane_identyfikacyjne.nip }}</p>
                {% if sprzedawca.adres %}
                <p>{{ sprzedawca.adres.adres_l1 }}<br>{{ sprzedawca.adres.adres_l2 }}</p>
                {% endif %}
                {% if sprzedawca.dane_kontaktowe %}
                <div class="contact-info">
                    {% for contact in sprzedawca.dane_kontaktowe %}
                    {% if contact.email %}<p>✉ {{ contact.email }}</p>{% endif %}
                    {% if contact.telefon %}<p>☎ {{ contact.telefon }}</p>{% endif %}
                    {% endfor %}
                </div>
                {% endif %}
            </div>
            
            <div class="party">
                <h2>Nabywca</h2>
                {% if nabywca.dane_identyfikacyjne.nazwa %}
                <p class="label">{{ nabywca.dane_identyfikacyjne.nazwa }}</p>
                {% elif nabywca.dane_identyfikacyjne.imie and nabywca.dane_identyfikacyjne.nazwisko %}
                <p class="label">{{ nabywca.dane_identyfikacyjne.imie }} {{ nabywca.dane_identyfikacyjne.nazwisko }}</p>
                {% endif %}
                {% if nabywca.dane_identyfikacyjne.pelna_nazwa %}
                <p>{{ nabywca.dane_identyfikacyjne.pelna_nazwa }}</p>
                {% endif %}
                {% if nabywca.dane_identyfikacyjne.nip %}
                <p><strong>NIP:</strong> {{ nabywca.dane_identyfikacyjne.nip }}</p>
                {% endif %}
                {% if nabywca.dane_identyfikacyjne.nip_ue %}
                <p><strong>NIP UE:</strong> {{ nabywca.dane_identyfikacyjne.nip_ue }}</p>
                {% endif %}
                {% if nabywca.adres %}
                <p>{{ nabywca.adres.adres_l1 }}<br>{{ nabywca.adres.adres_l2 }}</p>
                {% endif %}
                {% if nabywca.nr_klienta %}
                <p><strong>Nr klienta:</strong> {{ nabywca.nr_klienta }}</p>
                {% endif %}
                {% if nabywca.dane_kontaktowe %}
                <div class="contact-info">
                    {% for contact in nabywca.dane_kontaktowe %}
                    {% if contact.email %}<p>✉ {{ contact.email }}</p>{% endif %}
                    {% if contact.telefon %}<p>☎ {{ contact.telefon }}</p>{% endif %}
                    {% endfor %}
                </div>            {% endif %}
            <div style="margin-top: 10px;">
                {% if nabywca.dotyczy_jst == '1' %}
                <label style="font-size: 9pt;"><input type="checkbox" checked disabled> Faktura dotyczy jednostki podrzędnej JST</label><br>
                {% endif %}
                {% if nabywca.dotyczy_grupa_vat == '1' %}
                <label style="font-size: 9pt;"><input type="checkbox" checked disabled> Faktura dotyczy członka grupy VAT</label>
                {% endif %}
            </div>
        </div>
    </div>
    
    <!-- Podmiot trzeci (jeśli występuje) -->
        {% if podmiot3 and podmiot3|length > 0 %}
        {% for podmiot in podmiot3 %}
        <div class="third-party">
            <h3>Podmiot trzeci {% if podmiot3|length > 1 %}({{ loop.index }}){% endif %}</h3>
            
            <!-- Dane identyfikacyjne -->
            {% if podmiot.dane_identyfikacyjne %}
            {% set dane_id = podmiot.dane_identyfikacyjne %}
            {% if dane_id.nazwa %}
            <p><strong>Nazwa:</strong> {{ dane_id.nazwa }}</p>
            {% endif %}
            {% if dane_id.nip %}
            <p><strong>NIP:</strong> {{ dane_id.nip }}</p>
            {% endif %}
            {% if dane_id.nr_vat_ue %}
            <p><strong>VAT UE:</strong> {{ dane_id.kod_ue }}{{ dane_id.nr_vat_ue }}</p>
            {% endif %}
            {% if dane_id.nr_id %}
            <p><strong>Nr ID ({{ dane_id.kod_kraju }}):</strong> {{ dane_id.nr_id }}</p>
            {% endif %}
            {% if dane_id.id_wew %}
            <p><strong>ID wewnętrzny:</strong> {{ dane_id.id_wew }}</p>
            {% endif %}
            {% if dane_id.brak_id == '1' %}
            <p><strong>Brak identyfikatora</strong></p>
            {% endif %}
            {% endif %}
            
            <!-- Adres -->
            {% if podmiot.adres %}
            <p><strong>Adres:</strong><br>
            {{ podmiot.adres.adres_l1 }}{% if podmiot.adres.adres_l2 %}<br>{{ podmiot.adres.adres_l2 }}{% endif %}<br>
            {{ podmiot.adres.kod_kraju }}</p>
            {% endif %}
            
            <!-- Adres korespondencyjny -->
            {% if podmiot.adres_koresp %}
            <p><strong>Adres koresp.:</strong><br>
            {{ podmiot.adres_koresp.adres_l1 }}{% if podmiot.adres_koresp.adres_l2 %}<br>{{ podmiot.adres_koresp.adres_l2 }}{% endif %}<br>
            {{ podmiot.adres_koresp.kod_kraju }}</p>
            {% endif %}
            
            <!-- Dane kontaktowe -->
            {% if podmiot.dane_kontaktowe and podmiot.dane_kontaktowe|length > 0 %}
            {% for kontakt in podmiot.dane_kontaktowe %}
            {% if kontakt.email %}<p><strong>Email:</strong> {{ kontakt.email }}</p>{% endif %}
            {% if kontakt.telefon %}<p><strong>Telefon:</strong> {{ kontakt.telefon }}</p>{% endif %}
            {% endfor %}
            {% endif %}
            
            <!-- Rola -->
            {% if podmiot.rola or podmiot.rola_opis %}
            <p><strong>Rola:</strong> {% if podmiot.rola_opis %}{{ podmiot.rola_opis }}{% if podmiot.rola %} ({{ podmiot.rola }}){% endif %}{% elif podmiot.rola %}{{ podmiot.rola }}{% endif %}</p>
            {% endif %}
            
            <!-- Pozostałe -->
            {% if podmiot.udzial %}
            <p><strong>Udział:</strong> {{ podmiot.udzial }}%</p>
            {% endif %}
            {% if podmiot.nr_klienta %}
            <p><strong>Nr klienta:</strong> {{ podmiot.nr_klienta }}</p>
            {% endif %}
            {% if podmiot.id_nabywcy %}
            <p><strong>ID nabywcy:</strong> {{ podmiot.id_nabywcy }}</p>
            {% endif %}
            {% if podmiot.nr_eori %}
            <p><strong>Nr EORI:</strong> {{ podmiot.nr_eori }}</p>
            {% endif %}
        </div>    {% endfor %}
    <div style="margin-bottom: 30px;"></div>
    {% endif %}
    
    <!-- Korekta -->
    {% if korekta %}
    <div class="additional-info" style="margin-bottom: 15px;">
        <h3>Korekta</h3>
        
        {% if korekta.dane_fa_korygowanej and korekta.dane_fa_korygowanej|length > 0 %}
        <p class="info-item"><span class="label">Dane faktury korygowanej:</span></p>
        {% for f in korekta.dane_fa_korygowanej %}
            {% if f.numer %}
            <p class="info-item" style="margin-left: 20px;"><strong>Numer:</strong> {{ f.numer }}</p>
            {% endif %}
            {% if f.data_wystawienia %}
            <p class="info-item" style="margin-left: 20px;"><strong>Data wystawienia:</strong> {{ f.data_wystawienia }}</p>
            {% endif %}
        {% endfor %}
        {% endif %}
        
        {% if korekta.przyczyna_korekty %}
        <p class="info-item"><span class="label">Przyczyna korekty:</span> {{ korekta.przyczyna_korekty }}</p>
        {% endif %}
    </div>
    {% endif %}
    
    <!-- Pozycje faktury - STAN PRZED -->
    {% if pozycje and pozycje|length > 0 %}
        {% set pozycje_stan_przed = pozycje | selectattr('stan_przed', 'equalto', '1') | list %}
        
        {% if pozycje_stan_przed and pozycje_stan_przed|length > 0 %}
        <h3 style="margin-top: 10px; margin-bottom: 5px;">Pozycje - stan przed</h3>
        <table class="items-table">
            <thead>
                <tr>
                    <th class="center">Lp</th>
                    <th>Nazwa towaru/usługi</th>
                    <th class="number">Ilość</th>
                    <th>J.m.</th>
                    <th class="number">Cena netto</th>
                    <th class="number">Wartość netto</th>
                    <th class="number">VAT %</th>
                    <th class="number">Kwota VAT</th>
                    <th class="number">Wartość brutto</th>
                </tr>
            </thead>
            <tbody>
                {% for item in pozycje_stan_przed %}
                    <tr>
                        <td class="center">{{ item.nr_wiersza }}</td>
                        <td>
                            {{ item.nazwa }}
                            {% if item.pkwiu %}<br><small>PKWiU: {{ item.pkwiu }}</small>{% endif %}
                            {% if item.indeks %}<br><small>Indeks: {{ item.indeks }}</small>{% endif %}
                            {% if item.gtin %}<br><small>GTIN: {{ item.gtin }}</small>{% endif %}
                        </td>
                        <td class="number">{{ item.ilosc }}</td>
                        <td>{{ item.jednostka }}</td>
                        <td class="number">{{ item.cena_netto }}</td>
                        <td class="number">{{ item.wartosc_netto }}</td>
                        <td class="number">{{ item.stawka_vat }}</td>
                        <td class="number">{{ item.kwota_vat }}</td>
                        <td class="number">{{ item.wartosc_brutto }}</td>
                    </tr>
                {% endfor %}
            </tbody>
        </table>
        {% endif %}
    {% endif %}
    
    <!-- Pozycje faktury - aktualne -->
    {% if pozycje and pozycje|length > 0 %}
    {% set pozycje_stan_przed = pozycje | selectattr('stan_przed', 'equalto', '1') | list %}
    {% set pozycje_aktualne = pozycje | rejectattr('stan_przed', 'equalto', '1') | list %}
    {% if pozycje_stan_przed and pozycje_stan_przed|length > 0 and pozycje_aktualne and pozycje_aktualne|length > 0 %}
    <h3 style="margin-top: 15px; margin-bottom: 5px;">Pozycje - stan po</h3>
    {% endif %}
    <table class="items-table">
        <thead>
            <tr>
                <th class="center">Lp</th>
                <th>Nazwa towaru/usługi</th>
                <th class="number">Ilość</th>
                <th>J.m.</th>
                <th class="number">Cena netto</th>
                <th class="number">Wartość netto</th>
                <th class="number">VAT %</th>
                <th class="number">Kwota VAT</th>
                <th class="number">Wartość brutto</th>
            </tr>
        </thead>
        <tbody>
            {% for item in pozycje_aktualne %}
                <tr>
                    <td class="center">{{ item.nr_wiersza }}</td>
                    <td>
                        {{ item.nazwa }}
                        {% if item.pkwiu %}<br><small>PKWiU: {{ item.pkwiu }}</small>{% endif %}
                        {% if item.indeks %}<br><small>Indeks: {{ item.indeks }}</small>{% endif %}
